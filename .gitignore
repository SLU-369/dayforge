# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/.vinext/
/out/

# generated application and worker output
*.tsbuildinfo
build/
dist/
.wrangler/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment and local Cloudflare secrets
.env
.env.*
.env.local
.env*.local
*.env
*.env.*
.dev.vars
.dev.vars.*

# credentials must never be committed from platform or database folders
.openai/**/*.key
.openai/**/*.pem
.openai/**/*.p12
.openai/**/*.pfx
.openai/**/*credential*
.openai/**/*secret*
.openai/**/*token*
.openai/**/*service-account*.json
.openai/**/.env*
.openai/**/.dev.vars*
db/**/*.key
db/**/*.pem
db/**/*.p12
db/**/*.pfx
db/**/*credential*
db/**/*secret*
db/**/*token*
db/**/*service-account*.json
db/**/.env*
db/**/.dev.vars*
db/**/*.db
db/**/*.sqlite
db/**/*.sqlite3
db/**/*.local.json

# vercel
.vercel

/outputs/
/work/
